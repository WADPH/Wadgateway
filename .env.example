PORT=3000

# Target service base URL (for proxy and health checks)
TARGET_URL=http://192.168.1.50:2283

# Ping host to detect server power/network status
SERVER_PING_HOST=192.168.1.50

# Service health endpoint (relative path or full URL)
SERVICE_HEALTH_PATH=/api/server-info/ping

# Optional expected response text/JSON fragment.
# If empty, any HTTP 2xx from health endpoint is considered OK.
SERVICE_EXPECTED_TEXT=pong

# How long to wait after wake request (ms)
WAKE_TIMEOUT_MS=120000

# Poll intervals (ms)
PING_INTERVAL_MS=1000
STATUS_CACHE_TTL_MS=500
PING_TIMEOUT_MS=700
PING_SUCCESS_MIN=1
SERVICE_CHECK_TIMEOUT_MS=900

# Alternative power on via WadESP switch (https://github.com/WADPH/WadESP-PowerSW)
WadESPPowerSW=false
WadESP_IP=192.168.1.21

# Wake-on-LAN settings
WOL_MAC=AA:BB:CC:DD:EE:FF
WOL_BROADCAST=255.255.255.255
WOL_PORT=9

# UI text
SERVICE_NAME=Immich
READY_HINT=Service is available. Opening now...
WAKING_HINT=Server is waking up. This usually takes ~30 seconds.

# Temporary boot session behavior (optional, for wad-agent integration)
SERVER_ID=immich-main
TEMPORARY_REASON=immich
SESSION_TTL_SECONDS=120
SHUTDOWN_ALLOWED=true
IDLE_TIMEOUT_MINUTES=30
